{
  "name": "omnirift",
  "version": "0.1.143",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspace=apps/desktop",
    "tauri:dev": "npm run tauri:dev --workspace=apps/desktop",
    "tauri:build": "npm run tauri:build --workspace=apps/desktop",
    "tauri:lab": "npm run tauri:lab --workspace=apps/desktop",
    "tauri:build:lab": "npm run tauri:build:lab --workspace=apps/desktop",
    "lab:guard": "node scripts/lab-isolation-guard.mjs",
    "lab:sync": "bash scripts/lab-sync.sh",
    "install:macos-dev": "bash scripts/install-macos-dev.sh",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version:set": "node scripts/set-version.mjs",
    "gate:canvas-fluency": "bash scripts/canvas-fluency-gate.sh",
    "test:canvas-fluency": "npm run test:canvas-fluency --workspace=apps/desktop"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "monaco-editor": {
      "dompurify": "^3.4.12"
    }
  }
}
